{
  "name": "premier-league",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An unofficial, timezone-aware Premier League fixture viewer",
  "license": "MIT",
  "author": "Chester Ismay (https://chester.rbind.io)",
  "homepage": "https://ismayc.github.io/premier-league/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ismayc/premier-league.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fetch:fixtures": "node scripts/fetch-fixtures.mjs",
    "fetch:history": "node scripts/fetch-history.mjs",
    "fetch:stats": "node scripts/fetch-stats.mjs",
    "fetch:all": "npm run fetch:fixtures && npm run fetch:stats && npm run fetch:history"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
